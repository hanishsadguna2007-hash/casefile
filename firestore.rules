rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Dossiers: Each authenticated user can only read and write their own records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // All nested collections (attempts, case records, etc.)
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // User Points & Global Rankings: Publicly readable for rankings/leaderboards, writable by account owner
    match /user_points/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public Mystery cases (read-only for authenticated clients)
    match /mysteries/{mysteryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in [
        'hanishmummadi6600@gmail.com'
      ];
    }
  }
}

